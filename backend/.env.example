# Copy to backend/.env and edit. Never commit backend/.env.

# --- Camera ---------------------------------------------------------------
# stream      ESP32-CAM MJPEG (CAM_STREAM_URL)
# webcam      laptop webcam 0 (webcam:1 for another index)
# file:<path> loop a video or show a still image
# none        no camera
CAM_SOURCE=stream
CAM_STREAM_URL=http://192.168.4.2:81/stream
CAM_CAPTURE_URL=http://192.168.4.2/capture

# --- LLM ------------------------------------------------------------------
# anthropic (falls back to mock automatically if ANTHROPIC_API_KEY is empty) | qwen | mock
# qwen = local Qwen3-VL-4B via MLX (Apple Silicon); run the server in the cooking-vlm conda env
LLM_PROVIDER=anthropic
QWEN_MODEL=mlx-community/Qwen3-VL-4B-Instruct-4bit
QWEN_MAX_TOKENS=512
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# low | medium | high: higher is slower but more careful
LLM_EFFORT=low
# Server-side refusal fallback on the Claude API
LLM_FALLBACKS=true
MIN_CONFIDENCE=0.55

# --- Speech ---------------------------------------------------------------
# whisper (faster-whisper on CPU) | mock
STT_PROVIDER=whisper
WHISPER_MODEL=base
# What the mock STT "hears" (empty = nothing)
MOCK_TRANSCRIPT=
# edge (Microsoft Edge online voices, needs internet; beeps if offline) | beep
TTS_PROVIDER=edge
TTS_VOICE=en-US-AriaNeural

# --- Gestures -------------------------------------------------------------
GESTURE_ENABLED=true
GESTURE_FPS=10
GESTURE_HOLD_FRAMES=5
GESTURE_MIN_SCORE=0.6
GESTURE_COOLDOWN_S=3

# --- Orchestrator / server -------------------------------------------------
# false = speak the suggestion and wait for a thumbs-up before starting the timer
AUTO_START_TIMER=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
