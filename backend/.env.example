# Copy to backend/.env and edit. Never commit backend/.env.

# --- Camera ---------------------------------------------------------------
# stream      ESP32-CAM MJPEG (CAM_STREAM_URL)
# webcam      laptop webcam 0 (webcam:1 for another index)
# file:<path> loop a video or show a still image
# none        no camera
CAM_SOURCE=stream
CAM_STREAM_URL=http://192.168.4.2:81/stream
CAM_CAPTURE_URL=http://192.168.4.2/capture

# --- Vision model -----------------------------------------------------------
# qwen: the team's Qwen3-VL-4B in ../LLM/inference.py (Apple Silicon + MLX only)
# mock: canned observations (undercooked -> cooked -> burning), runs anywhere
VISION_PROVIDER=qwen
# Path to the model code (default: <repo>/LLM/inference.py)
VLM_INFERENCE_PATH=
# Override inference.py's MODEL_ID (empty = mlx-community/Qwen3-VL-4B-Instruct-4bit)
VLM_MODEL_ID=
VLM_MAX_TOKENS=200

# --- Continuous monitoring -------------------------------------------------
# Look at the latest frame this often during a session (never more than one inference in flight)
MONITOR_INTERVAL_S=4
# Skip frames older than this; drop results whose frame is older than RESULT_MAX_AGE_S on arrival
FRAME_MAX_AGE_S=2
RESULT_MAX_AGE_S=20
# Consecutive "burnt" observations before an overcook warning, and the repeat interval
OVERCOOK_CONFIRM=2
OVERCOOK_REPEAT_S=60
LOOKS_DONE_CONFIRM=2
# Raise a MONITORING_LOST alert after the camera has been stale this long during a session
CAMERA_LOST_AFTER_S=20

# --- Speech ---------------------------------------------------------------
# whisper (faster-whisper on CPU) | mock
STT_PROVIDER=whisper
WHISPER_MODEL=base
# What the mock STT "hears" (empty = nothing)
MOCK_TRANSCRIPT=
# edge (Microsoft Edge online voices, needs internet; beeps if offline) | beep
TTS_PROVIDER=edge
TTS_VOICE=en-US-AriaNeural

# --- Gestures -------------------------------------------------------------
GESTURE_ENABLED=true
GESTURE_FPS=10
GESTURE_HOLD_FRAMES=5
GESTURE_MIN_SCORE=0.6
GESTURE_COOLDOWN_S=3

# --- Orchestrator / server -------------------------------------------------
# Typical cook times are suggestions. false = wait for a thumbs-up before starting the timer.
AUTO_START_TIMER=false
# Session snapshot (timer, alerts) survives restarts. Empty disables persistence.
STATE_FILE=data/session.json
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
